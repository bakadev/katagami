# Copy to /opt/docker/katagami/.env on the VPS. Never commit the real file.
# Generate a password with:  openssl rand -base64 32
POSTGRES_PASSWORD=change_me

# --- Auth (production) --------------------------------------------------------
# See docs/oauth-prep.md. Use the production GitHub app, not the local one.
APP_URL=https://katagami.bakadev.cloud
API_URL=https://katagami.bakadev.cloud
SESSION_SECRET=            # openssl rand -base64 32, different from local
GOOGLE_CLIENT_ID=389018847326-ge5r5ipd5st9uvf7kn0haugm0t4cqdbu.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
