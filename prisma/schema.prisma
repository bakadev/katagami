generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  creatorToken  String    @map("creator_token")
  workspaceId   String?   @map("workspace_id") @db.Uuid
  ownerId       String?   @map("owner_id") @db.Uuid
  // One hidden default project per user holds their documents "not in a
  // project". On Free it is the only project they have.
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  documents     Document[]
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner         User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("projects")
  @@index([creatorToken])
  @@index([workspaceId])
  @@index([ownerId])
}

// ---- accounts ---------------------------------------------------------------
// Email is the identity: one User, any number of provider Accounts.

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  name       String
  avatarUrl  String?   @map("avatar_url")
  // Caret and comment colour, chosen in the account menu.
  color      String?
  // Admin override of the plan: "free" | "team" | null (derive from teams).
  planOverride String? @map("plan_override")
  createdAt  DateTime  @default(now()) @map("created_at")

  accounts   Account[]
  sessions   Session[]
  workspaces WorkspaceMember[]
  projects   Project[]

  @@map("users")
}

model Account {
  provider    String    // 'github' | 'google'
  providerId  String    @map("provider_id")
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerId])
  @@map("accounts")
  @@index([userId])
}

model Session {
  id         String    @id                    // sha256 of the cookie token
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Workspace {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  createdAt  DateTime  @default(now()) @map("created_at")

  members    WorkspaceMember[]
  projects   Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         String    // 'owner' | 'editor'
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
  @@index([userId])
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String?
  yjsState    Bytes?    @map("yjs_state")
  // Denormalised at persist time so listings never decode Yjs.
  lastEditedByName   String?  @map("last_edited_by_name")
  lastEditedByColor  String?  @map("last_edited_by_color")
  openComments       Int      @default(0) @map("open_comments")
  openSuggestions    Int      @default(0) @map("open_suggestions")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots   Snapshot[]
  permissions Permission[]

  @@map("documents")
  @@index([projectId])
}

model Snapshot {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  yjsState     Bytes     @map("yjs_state")
  takenAt      DateTime  @default(now()) @map("taken_at")
  takenByName  String?   @map("taken_by_name")
  name         String?

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("snapshots")
  @@index([documentId, takenAt])
  @@index([documentId, name])
}

model Permission {
  documentId   String    @map("document_id") @db.Uuid
  level        String    // 'edit' | 'view'
  token        String    @unique

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, level])
  @@map("permissions")
  @@index([token])
}
